# Database selection: sqlite or postgresql
DB_ENGINE=sqlite

# Django settings
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL configuration (used only when DB_ENGINE=postgresql)
DB_NAME=sap_it_dashboard
DB_USER=postgres
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=5432
